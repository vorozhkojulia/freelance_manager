      "css": ".ds-board{background:oklch(0.36 0.07 270);padding:20px}.ds-btn-board{background:transparent;color:oklch(0.992 0.003 95);border:1px solid oklch(0.992 0.003 95 / .3);border-radius:6px;padding:6px 12px;font:500 14px Archivo,system-ui,sans-serif;cursor:pointer}.ds-btn-board:hover{background:oklch(0.992 0.003 95 / .1)}.ds-btn-board:focus-visible{outline:2px solid oklch(0.62 0.19 40);outline-offset:2px}"
