      "html": "<div class=\"ds-tabs\"><button class=\"ds-tab ds-tab-on\">Dashboard</button><button class=\"ds-tab\">Timeline</button><button class=\"ds-tab\">Finances <span class=\"ds-badge\">2</span></button></div>",
      "css": ".ds-tabs{background:oklch(0.27 0.06 270);padding:12px;display:flex;gap:4px}.ds-tab{background:transparent;border:0;border-radius:9999px;padding:6px 14px;color:oklch(0.992 0.003 95 / .75);font:500 14px Archivo,system-ui,sans-serif;cursor:pointer;display:inline-flex;gap:8px;align-items:center}.ds-tab:hover{color:oklch(0.992 0.003 95)}.ds-tab-on{background:oklch(0.992 0.003 95);color:oklch(0.24 0.025 255)}.ds-tab:focus-visible{outline:2px solid oklch(0.62 0.19 40);outline-offset:2px}.ds-badge{background:oklch(0.62 0.19 40);color:#fff;border-radius:9999px;padding:0 6px;min-width:20px;text-align:center;font:500 11px/20px 'JetBrains Mono',monospace}"
