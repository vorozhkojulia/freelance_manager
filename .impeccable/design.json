      "css": ".ds-input{background:oklch(0.992 0.003 95);color:oklch(0.24 0.025 255);border:1px solid oklch(0.76 0.01 250);border-radius:6px;padding:6px 10px;font:14px Archivo,system-ui,sans-serif;caret-color:oklch(0.62 0.19 40)}.ds-input::placeholder{color:oklch(0.5 0.018 255)}.ds-input:focus-visible{border-color:oklch(0.62 0.19 40);outline:2px solid oklch(0.62 0.19 40);outline-offset:2px}"
