      "css": ".ds-pill{display:inline-flex;border-radius:9999px;padding:2px 8px;font:500 12px Archivo,system-ui,sans-serif}.ds-paid{color:oklch(0.46 0.1 155);background:oklch(0.94 0.04 155)}.ds-pend{color:oklch(0.47 0.1 75);background:oklch(0.95 0.055 88)}.ds-late{color:oklch(0.5 0.18 38);background:oklch(0.95 0.035 45)}"
    },
    {
      "name": "Sticky Note",
      "kind": "card",
      "refersTo": "sticky-note",
      "description": "Pinned project note: pushpin, handwritten name, due stamp, tasks, price.",
      "html": "<div class=\"ds-wall\"><div class=\"ds-note\"><span class=\"ds-pin\"></span><div class=\"ds-name\">Brand refresh</div><div class=\"ds-client\">Northwind</div><div class=\"ds-row\"><span class=\"ds-mono\">Due 3 Oct</span><span class=\"ds-stamp\">in 4 days</span></div><div class=\"ds-task\"><span class=\"ds-box\"></span>Send moodboard</div><div class=\"ds-foot\"><span class=\"ds-mono ds-price\">EUR 2,400</span></div></div></div>",
      "css": ".ds-wall{background-color:oklch(0.36 0.07 270);background-image:radial-gradient(oklch(1 0 0 / .07) 1.2px,transparent 1.5px);background-size:22px 22px;padding:28px}.ds-note{position:relative;width:248px;min-height:200px;padding:28px 16px 16px;background:oklch(0.93 0.15 100);background-image:linear-gradient(165deg,oklch(1 0 0 / .38),transparent 42%);box-shadow:0 1px 0 oklch(0.2 0.05 60 / .12),0 14px 16px -8px oklch(0.1 0.05 270 / .55);transform:rotate(-2.4deg);color:oklch(0.24 0.025 255);font-family:Archivo,system-ui,sans-serif;transition:box-shadow 220ms cubic-bezier(.16,1,.3,1),transform 220ms}.ds-note:hover{transform:rotate(0) scale(1.03);box-shadow:0 1px 0 oklch(0.2 0.05 60 / .12),0 26px 24px -10px oklch(0.1 0.05 270 / .65)}.ds-pin{position:absolute;top:-10px;left:50%;width:24px;height:24px;margin-left:-12px;border-radius:50%;background:radial-gradient(circle at 32% 30%,oklch(0.86 0.13 45),oklch(0.6 0.2 38) 55%,oklch(0.42 0.16 35));box-shadow:0 5px 5px -2px oklch(0.1 0.05 270 / .55)}.ds-name{font:700 23px/1.05 Kalam,'Segoe Print',cursive}.ds-client{font-size:13px;color:oklch(0.4 0.02 255);margin-top:4px}.ds-row{display:flex;justify-content:space-between;align-items:center;margin-top:12px}.ds-mono{font-family:'JetBrains Mono',monospace;font-size:12px}.ds-stamp{font:600 11px 'JetBrains Mono',monospace;text-transform:uppercase;border:2px solid oklch(0.5 0.18 38);color:oklch(0.5 0.18 38);border-radius:2px;padding:2px 6px;transform:rotate(-3deg)}.ds-task{display:flex;gap:8px;align-items:flex-start;font-size:13px;margin-top:12px}.ds-box{width:16px;height:16px;border:2px solid oklch(0.24 0.025 255 / .7);border-radius:4px;background:oklch(1 0 0 / .4);flex:none}.ds-foot{display:flex;justify-content:flex-end;margin-top:24px}.ds-price{font-size:14px;font-weight:600}"
    },
    {
      "name": "Paper Sheet",
      "kind": "card",
      "refersTo": "panel-paper",
      "description": "Paper sheet lifted off the felt, with section title.",
      "html": "<div class=\"ds-wall2\"><section class=\"ds-sheet\"><div class=\"ds-head\"><h2>Next six weeks</h2><span>deadlines on top, hours below</span></div><p>Chart or table content sits here.</p></section></div>",
      "css": ".ds-wall2{background:oklch(0.36 0.07 270);padding:24px}.ds-sheet{background:oklch(0.992 0.003 95);color:oklch(0.24 0.025 255);border-radius:12px;padding:20px;box-shadow:0 18px 30px -16px oklch(0.1 0.05 270 / .7);font-family:Archivo,system-ui,sans-serif}.ds-head{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin-bottom:12px}.ds-head h2{font-size:16px;font-weight:600;letter-spacing:-0.025em;margin:0}.ds-head span{font-size:14px;color:oklch(0.5 0.018 255)}.ds-sheet p{margin:0;font-size:15px}"
    },
    {
      "name": "Receipt Tape",
      "kind": "custom",
      "refersTo": "receipt-tape",
      "description": "Torn-edge money receipt with dotted leaders and a segmented bar.",
      "html": "<div class=\"ds-wall2\"><div class=\"ds-tape\"><div class=\"ds-tl\">MONEY · EUR</div><div class=\"ds-line\"><span>Received</span><i></i><b style=\"color:oklch(0.46 0.1 155)\">4,800</b></div><div class=\"ds-line\"><span>Awaiting payment</span><i></i><b style=\"color:oklch(0.47 0.1 75)\">2,100</b></div><div class=\"ds-tot\"><span>Still expected</span><b>3,600</b></div><div class=\"ds-bar\"><u style=\"flex-grow:4.8;background:oklch(0.46 0.1 155)\"></u><u style=\"flex-grow:2.1;background:oklch(0.47 0.1 75)\"></u><u class=\"ds-hatch\" style=\"flex-grow:1.5\"></u></div></div></div>",
      "css": ".ds-wall2{background:oklch(0.36 0.07 270);padding:24px}.ds-tape{width:280px;background:oklch(0.992 0.003 95);color:oklch(0.24 0.025 255);padding:20px 16px;font-family:Archivo,system-ui,sans-serif;-webkit-mask:conic-gradient(from -45deg at bottom,#0000,#000 1deg 89deg,#0000 90deg) bottom/12px 51% repeat-x,conic-gradient(from 135deg at top,#0000,#000 1deg 89deg,#0000 90deg) top/12px 51% repeat-x;mask:conic-gradient(from -45deg at bottom,#0000,#000 1deg 89deg,#0000 90deg) bottom/12px 51% repeat-x,conic-gradient(from 135deg at top,#0000,#000 1deg 89deg,#0000 90deg) top/12px 51% repeat-x}.ds-tl{font:11px 'JetBrains Mono',monospace;letter-spacing:.06em;color:oklch(0.5 0.018 255);text-align:center;margin-bottom:8px}.ds-line{display:flex;align-items:baseline;gap:8px;padding:6px 8px;font-size:14px}.ds-line i{flex:1;min-width:12px;border-bottom:2px dotted oklch(0.76 0.01 250);transform:translateY(-4px)}.ds-line b{font:500 15px 'JetBrains Mono',monospace}.ds-tot{display:flex;justify-content:space-between;align-items:baseline;margin:8px;padding-top:8px;border-top:1px dashed oklch(0.76 0.01 250);font-weight:600;font-size:14px}.ds-tot b{font:600 20px 'JetBrains Mono',monospace}.ds-bar{display:flex;gap:1px;height:12px;margin:0 8px;border-radius:9999px;overflow:hidden;background:oklch(0.895 0.009 245)}.ds-bar u{flex-basis:0;text-decoration:none}.ds-hatch{background-image:repeating-linear-gradient(135deg,oklch(0.76 0.01 250) 0 1.5px,transparent 1.5px 6px)}"
    }
  ],
  "narrative": {
    "northStar": "The Studio Wall",
    "overview": "A designer's pinboard in a working studio. Deep indigo felt with a faint dot texture is the wall; active projects are colored sticky notes pinned to it, slightly tilted, draggable, tickable and unpinnable. Anything that needs to be read carefully (the deadline runway, the project table, the money) sits on a flat sheet of paper laid over the wall. The mood is warm, handmade and tactile, but the data underneath stays exact and tabular.\n\nThree voices divide the work. Kalam handwriting is the human voice: project names on notes and the Next-up line. Archivo is the interface voice. JetBrains Mono carries figures, dates, codes and the small uppercase table heads. Color has one job per family: six sticky colors identify a project everywhere it appears; signal orange means pinned, urgent or focused; green and amber mean money state.",
    "keyCharacteristics": [
      "Felt wall (board) as the dashboard ground, paper sheets and receipt tape as the reading surfaces.",
      "Six sticky colors bound to a project by list position, carried into chart bars, deadline flags, list swatches and pin toggles.",
      "Kalam only for project names and the Next-up line; everything else is Archivo or JetBrains Mono.",
      "One signal orange for pushpins, urgency, today marker, badges and focus.",
      "Cross-highlighting: hover or focus a project in any view and all views of it light up while the rest dim.",
      "Depth is physical: dark indigo-tinted casts under notes and sheets."
    ],
    "rules": [
      {
        "name": "The Project Color Rule",
        "body": "A project's sticky color follows it across every screen. Colors identify projects, never status or severity.",
        "section": "colors"
      },
      {
        "name": "The One Pin Rule",
        "body": "Signal orange means pinned, urgent, today or focused. It is never a button fill or decoration.",
        "section": "colors"
      },
      {
        "name": "The Money Tint Rule",
        "body": "Green and amber appear only on money state.",
        "section": "colors"
      },
      {
        "name": "The Hand Is Names Rule",
        "body": "Kalam is for project names and the Next-up sentence only. Controls, figures and body copy never use it.",
        "section": "typography"
      },
      {
        "name": "The Mono Is Data Rule",
        "body": "Anything read off a receipt or docket (price, date, code, hours, days) is mono; sentences are Archivo.",
        "section": "typography"
      },
      {
        "name": "The Cast, Not Glow Rule",
        "body": "Shadows are soft, low, board-tinted casts of a physical object. No colored glows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do bind each project to one sticky color and use its `-deep` tone wherever the color must sit on paper.",
      "Do set figures, dates and codes in JetBrains Mono with tabular numerals.",
      "Do keep orange for pins, urgency, today, badges and focus; use `signal-ink` for orange text.",
      "Do show depth with board-tinted casts and let notes straighten and lift on hover.",
      "Do keep every hover-highlight cross-linked: a project lit in one view lights in all.",
      "Do respect reduced motion; state transitions run 200-300ms on ease-out-expo (`cubic-bezier(0.16, 1, 0.3, 1)`), notes and tabs use springs."
    ],
    "donts": [
      "Don't put Kalam on controls, figures, tables or body copy.",
      "Don't use sticky colors for status or severity, or green and amber outside money state.",
      "Don't use torn or sawtooth edges on anything other than receipt-like objects.",
      "Don't add dark mode; paper sheets and pastel notes are the world.",
      "Don't fall back to a uniform SaaS card grid or hero KPI tiles for pinned projects."
    ]
  }
}